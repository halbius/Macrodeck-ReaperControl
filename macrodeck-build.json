{
  "version": 1,
  "targets": {
    "win-x64": {
      "executable": "dotnet",
      "arguments": [
        "publish",
        "ReaperControl.csproj",
        "-c",
        "Release",
        "-r",
        "win-x64",
        "--self-contained",
        "false",
        "-p:UseAppHost=false",
        "-o",
        "bin/publish/win-x64"
      ],
      "output": "bin/publish/win-x64"
    },
    "osx-arm64": {
      "executable": "dotnet",
      "arguments": [
        "publish",
        "ReaperControl.csproj",
        "-c",
        "Release",
        "-r",
        "osx-arm64",
        "--self-contained",
        "false",
        "-p:UseAppHost=false",
        "-o",
        "bin/publish/osx-arm64"
      ],
      "output": "bin/publish/osx-arm64"
    },
    "osx-x64": {
      "executable": "dotnet",
      "arguments": [
        "publish",
        "ReaperControl.csproj",
        "-c",
        "Release",
        "-r",
        "osx-x64",
        "--self-contained",
        "false",
        "-p:UseAppHost=false",
        "-o",
        "bin/publish/osx-x64"
      ],
      "output": "bin/publish/osx-x64"
    }
  },
  "include": [
    "README.md",
    "ReaperScripts",
    "Assets/Icons"
  ]
}
